<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <!-- Kanalauswahl: Kamera deaktiviert/aktiviert (1 Bit, ETS zeigt Radio-Buttons) -->
              <ParameterType Id="%AID%_PT-IPCChannelActive" Name="IPCChannelActive">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%AID%_PT-IPCChannelActive_EN-0" />
                  <Enumeration Text="Aktiviert"   Value="1" Id="%AID%_PT-IPCChannelActive_EN-1" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCManufacturer" Name="IPCManufacturer">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Reolink"    Value="0" Id="%AID%_PT-IPCManufacturer_EN-0" />
                  <Enumeration Text="Hikvision (experimentell)"  Value="1" Id="%AID%_PT-IPCManufacturer_EN-1" />
                  <Enumeration Text="Dahua (experimentell)"      Value="2" Id="%AID%_PT-IPCManufacturer_EN-2" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCDeviceType" Name="IPCDeviceType">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Kamera"     Value="0" Id="%AID%_PT-IPCDeviceType_EN-0" />
                  <Enumeration Text="Türklingel" Value="1" Id="%AID%_PT-IPCDeviceType_EN-1" />
                  <Enumeration Text="NVR-Kanal"  Value="2" Id="%AID%_PT-IPCDeviceType_EN-2" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCConnType" Name="IPCConnType">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="LAN (PoE oder Netzteil)" Value="0" Id="%AID%_PT-IPCConnType_EN-0" />
                  <Enumeration Text="WLAN (mit Netzteil)"     Value="1" Id="%AID%_PT-IPCConnType_EN-1" />
                  <Enumeration Text="WLAN (Akku)"             Value="2" Id="%AID%_PT-IPCConnType_EN-2" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCYesNo" Name="IPCYesNo">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="Nein" Value="0" Id="%AID%_PT-IPCYesNo_EN-0" />
                  <Enumeration Text="Ja"   Value="1" Id="%AID%_PT-IPCYesNo_EN-1" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCPolling" Name="IPCPolling">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="5 Sekunden"  Value="0" Id="%AID%_PT-IPCPolling_EN-0" />
                  <Enumeration Text="10 Sekunden" Value="1" Id="%AID%_PT-IPCPolling_EN-1" />
                  <Enumeration Text="30 Sekunden" Value="2" Id="%AID%_PT-IPCPolling_EN-2" />
                  <Enumeration Text="60 Sekunden" Value="3" Id="%AID%_PT-IPCPolling_EN-3" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCHoldTime" Name="IPCHoldTime">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="5" maxInclusive="300" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCNvrChannel" Name="IPCNvrChannel">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="15" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCString80" Name="IPCString80">
                <TypeText SizeInBit="640" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCString32" Name="IPCString32">
                <TypeText SizeInBit="256" />
              </ParameterType>              <ParameterType Id="%AID%_PT-IPCString64" Name="IPCString64">      
                <TypeText SizeInBit="512" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCConnMode" Name="IPCConnMode">
                <TypeRestriction Base="Value" SizeInBit="8">
                  <Enumeration Text="JSON Polling"        Value="0" Id="%AID%_PT-IPCConnMode_EN-0" />
                  <Enumeration Text="ONVIF Long Poll"     Value="1" Id="%AID%_PT-IPCConnMode_EN-1" />
                  <Enumeration Text="ONVIF + JSON kombiniert" Value="2" Id="%AID%_PT-IPCConnMode_EN-2" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IPCPort" Name="IPCPort">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="1" maxInclusive="65535" />
              </ParameterType>
              <!-- Ausstattungs-Haken; wird vom Assistenten aus GetAbility befüllt -->
              <ParameterType Id="%AID%_PT-IPCCheck" Name="IPCCheck">
                <TypeRestriction Base="Value" SizeInBit="1">
                  <Enumeration Text="Nein" Value="0" Id="%AID%_PT-IPCCheck_EN-0" />
                  <Enumeration Text="Ja"   Value="1" Id="%AID%_PT-IPCCheck_EN-1" />
                </TypeRestriction>
              </ParameterType>
            </ParameterTypes>
            <Parameters />
            <ParameterRefs />
            <ComObjectTable />
            <ComObjectRefs />
            <Script>
              <op:include href="IPCameraModule.script.js" type="script" />
            </Script>
          </Static>
          <Dynamic>
            <Channel Name="MainChannel%TT%" Text="IP Kamera" Number="%PREFIX%" Id="%AID%_CH-%TT%" Icon="movie-open-outline">
              <ParameterBlock Id="%AID%_PB-nnn" Name="IPCSettings" Text="Allgemein" Icon="cog-outline" HelpContext="IPC-Allgemein">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="IP Kamera" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
              </ParameterBlock>
              <!-- Kanalauswahl: je Kamera eine einzeilige Tabelle (OpenKNX-Standard) -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="IPCChannelSelect" Text="Kanalauswahl" Icon="format-list-bulleted-type" HelpContext="BASE-ChannelSelect">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" UIHint="Headline" Text="Kanal" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,2" UIHint="Headline" Text="Kanalaktivität" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,3" UIHint="Headline" Text="Beschreibung" />
                </ParameterBlock>
                <op:include href="IPCameraModule.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="IPC" IsInner="true" />
              </ParameterBlock>
              <!-- Kamera-Tabs (nur aktivierte Kameras) -->
              <op:include href="IPCameraModule.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="IPC" IsInner="true" />
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>
